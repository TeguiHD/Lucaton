# Lucatón - Variables de Entorno
# Copiar a .env y configurar valores reales

# === CONFIGURACIÓN DE BASE DE DATOS ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lucaton_db
DB_USER=lucaton_user
DB_PASS=tu_password_seguro_aqui
DB_CHARSET=utf8mb4

# === CONFIGURACIÓN DE APLICACIÓN ===
APP_NAME="Lucatón - Crowdfunding Social"
APP_ENV=development
APP_DEBUG=true
APP_URL=https://www.lucaton.org/
APP_TIMEZONE=America/Santiago
PROJECT_OWNER_NAME="Proyecto Lucatón — Tesis Universidad Bernardo O'Higgins"
PROJECT_OWNER_EMAIL=nlopetegui@pregrado.ubo.cl
PROJECT_DISCLAIMER="Prototipo académico sin fines comerciales. Los datos de contacto se proveen solo para fines universitarios."

# === CONFIGURACIÓN DE ARCHIVOS ===
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
STORAGE_PUBLIC_PATH=public/storage/uploads
STORAGE_PRIVATE_PATH=storage/private
STORAGE_AI_PATH=storage/ai_files

# === CONFIGURACIÓN DE IA ===
OPENROUTER_API_KEY=tu_api_key_openrouter
OPENROUTER_MODEL=tngtech/deepseek-r1t2-chimera:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=640
OPENROUTER_REFERER=https://tu-sitio-ejemplo.cl
OPENROUTER_TITLE="Centro de Ayuda Lucatón"

GOOGLE_AI_API_KEYS=clave_google_1,clave_google_2,clave_google_3
GOOGLE_AI_TEXT_MODEL=gemini-2.5-flash-lite
# Usa /v1 para compatibilidad con Thinking (evita v1beta en producción)
GOOGLE_AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1
GOOGLE_AI_USE_THINKING=false
GOOGLE_AI_THINKING_BUDGET=0
AI_TEXT_TEMPERATURE=0.65

# === LÍMITES Y SEGURIDAD ===
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_AI_REQUESTS=10
RATE_LIMIT_WINDOW=3600
ASSET_VERSION=

SESSION_LIFETIME=7200
SESSION_NAME=lucaton_session
CSRF_TOKEN_NAME=csrf_token
SESSION_SIGNATURE_KEY=
ROLE_SIGNATURE_KEY=
APP_SUPERADMIN_AUTO_PROMOTE=false
SUPERADMIN_SEEDS_ALGO=sha256
SUPERADMIN_SEEDS_SECRET=
SUPERADMIN_SEEDS_HASHED=

# === CONFIGURACIÓN DE LOGS ===
LOG_LEVEL=info
LOG_PATH=storage/logs
LOG_MAX_FILES=30

# === CONFIGURACIÓN ACADÉMICA ===
RESEARCH_MODE=true
METRICS_ENABLED=true
AB_TESTING_ENABLED=true

# === CONFIGURACIÓN DE EMAIL (opcional) ===
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_password_email
MAIL_FROM_ADDRESS=noreply@tesis-lucaton.example.com
MAIL_FROM_NAME="Lucatón"
